# NTNU FEIDE credentials - used to auto-fill the login form.
# Email is stored here. Password is read from system keyring (preferred) or FEIDE_PASSWORD.
#
# Laptop setup (one-time):
#   secret-tool store --label="NTNU FEIDE" service koker username your.name@stud.ntnu.no
#
# Server / fallback: set FEIDE_PASSWORD below (file should be chmod 600).
FEIDE_USER=your.name@stud.ntnu.no
FEIDE_PASSWORD=

# Gmail notifications
GMAIL_FROM=
GMAIL_TO=
GMAIL_APP_PASSWORD=
